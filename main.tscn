[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://main_menu.gd" id="1"]

[node name="MainMenu" type="Node2D"]
script = ExtResource("1")

[node name="UI" type="CanvasLayer" parent="."]

[node name="VBox" type="VBoxContainer" parent="UI"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -100.0
offset_top = -80.0
offset_right = 100.0
offset_bottom = 80.0
grow_horizontal = 2
grow_vertical = 2
alignment = 1

[node name="Title" type="Label" parent="UI/VBox"]
layout_mode = 2
text = "My Game"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 32

[node name="Spacer" type="Control" parent="UI/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 20)

[node name="StartButton" type="Button" parent="UI/VBox"]
layout_mode = 2
text = "Start Game"

[node name="Spacer2" type="Control" parent="UI/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 8)

[node name="LoadButton" type="Button" parent="UI/VBox"]
layout_mode = 2
text = "Load Game"

[node name="ConfirmDialog" type="ConfirmationDialog" parent="UI"]
title = "Overwrite Save?"
dialog_text = "Starting a new game will overwrite your save. Continue?"

[connection signal="pressed" from="UI/VBox/StartButton" to="." method="_on_start_button_pressed"]
[connection signal="confirmed" from="UI/ConfirmDialog" to="." method="_on_confirm_dialog_confirmed"]
[connection signal="pressed" from="UI/VBox/LoadButton" to="." method="_on_load_button_pressed"]
